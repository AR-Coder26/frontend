# Base URL of the Express backend's API (see backend/src/app.js — every route is mounted
# under /api, and backend/.env.example defaults PORT to 5000 with CLIENT_URL=http://localhost:3000,
# which is Next's own default dev port — no CORS changes needed for local dev as-is).
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name