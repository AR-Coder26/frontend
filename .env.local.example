# frontend/.env.local.example
# Copy to .env.local (local dev) or add these in Vercel > Project > Settings > Environment Variables.
# NEXT_PUBLIC_* values are baked in at BUILD time — change one, then redeploy.

# Full URL of the backend API, INCLUDING its /api prefix. No trailing slash needed.
#   local dev:   the port in backend/.env (PORT) -> http://localhost:<PORT>/api
#   production:  https://<your-backend-host>/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional. Set to "true" while the backend and frontend are on unrelated hosts (e.g. two
# *.vercel.app projects): the browser then talks to this site's own /api and Next forwards it to
# NEXT_PUBLIC_API_URL, so login cookies are first-party and work in Safari / strict browsers.
# Leave unset for local dev, and once the backend is on a subdomain of your own domain
# (set COOKIE_DOMAIN on the backend instead).
NEXT_PUBLIC_API_PROXY=true

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
